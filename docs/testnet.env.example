# OxDeAI x402 testnet demonstration (Celo Sepolia ONLY). Placeholders only.
# Copy OUTSIDE the repository, fill in, then `source` it. Never commit the filled file.

# 0600 file with a NEW testnet-only private key (64 hex chars), funded with Celo Sepolia USDC.
export OXDEAI_TESTNET_PAYER_KEY_FILE="$HOME/.oxdeai/celo-sepolia-payer.key"

# Approved recipient: a second testnet address you control (lower-case 0x + 40 hex).
export OXDEAI_TESTNET_PAY_TO="0x<your-testnet-recipient-address>"

# Celo x402 facilitator API key (https://x402.celo.org). Seller side only.
export OXDEAI_X402_API_KEY="<your-facilitator-api-key>"

# Optional (defaults shown).
# export OXDEAI_TESTNET_RPC_URL="https://forno.celo-sepolia.celo-testnet.org"
# export OXDEAI_X402_FACILITATOR_URL="https://api.x402.sepolia.celo.org"
# export OXDEAI_TESTNET_PRICE="1000"            # 0.001 USDC (max 2000)
# export OXDEAI_TESTNET_EVIDENCE_DIR="evidence/testnet"
